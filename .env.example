# Public settings: safe to include in the browser bundle.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server-only settings: never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_CLINIC_MONTHLY=
STRIPE_PRICE_CLINIC_ANNUAL=
# Optional separate Portal configuration (omit entirely to use the Stripe default).
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_...

# At least 32 random characters; keep stable for analytics hashing.
IP_HASH_SALT=

# Required for the deployed scheduled upload cleanup endpoint; at least 32 random characters.
CRON_SECRET=
